generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  decisions Decision[]
}

model Decision {
  id              String   @id @default(uuid())
  statement       String
  targetCustomer  String?
  market          String?
  budget          String?
  timeline        String?
  currentEvidence String?
  alternatives    String?
  
  readinessScore  Int      @default(0)
  status          String   @default("ANALYZING") // ANALYZING, IN_PROGRESS, READY, DECIDED
  recommendation  String?
  recommendationReasoning String?
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  assumptions     Assumption[]
  evidence        Evidence[]
  signals         Signal[]
  experiments     Experiment[]
  outcome         Outcome?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Assumption {
  id               String   @id @default(uuid())
  decisionId       String
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  title            String
  description      String
  importance       String   // low, medium, high, critical
  confidence       Int      // 0-100
  evidenceStrength String   // none, weak, moderate, strong
  status           String   // supported, uncertain, unsupported, contradicted
  proveCondition   String
  disproveCondition String
  isBlindSpot      Boolean  @default(false)
  
  evidenceLinks    EvidenceAssumption[]
}

model Evidence {
  id               String   @id @default(uuid())
  decisionId       String
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  source           String
  date             DateTime @default(now())
  content          String
  type             String   // text, note, url, file, observation, interview, survey, review
  classification   String   // supports, contradicts, neutral, insufficient
  nature           String   // FACT, USER CLAIM, INFERENCE, UNKNOWN
  strength         String   // weak, moderate, strong
  
  assumptionLinks  EvidenceAssumption[]
}

model EvidenceAssumption {
  evidenceId   String
  assumptionId String
  evidence     Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  assumption   Assumption @relation(fields: [assumptionId], references: [id], onDelete: Cascade)
  @@id([evidenceId, assumptionId])
}

model Signal {
  id               String   @id @default(uuid())
  decisionId       String
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  title            String
  explanation      String
  observations     Int
  importance       String   // low, medium, high, critical
  confidence       Int
  customerSegment  String?
  recommendedAction String
  isCrossSignal    Boolean  @default(false)
  type             String   // RISK, OPPORTUNITY, EMERGING_PATTERN, CUSTOMER_FRICTION, UNUSUAL_CHANGE, REVENUE_THREAT
}

model Experiment {
  id               String   @id @default(uuid())
  decisionId       String
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  name             String
  whyItMatters     String
  hypothesis       String
  objective        String
  whoToTest        String
  steps            String
  interviewQuestions String
  successThreshold String
  failureThreshold String
  changeCondition  String
  costEstimate     String
  timeEstimate     String
  status           String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETE
  
  result           ExperimentResult?
}

model ExperimentResult {
  id               String     @id @default(uuid())
  experimentId     String     @unique
  experiment       Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  resultData       String
  extractedEvidence String?
  readinessBefore  Int
  readinessAfter   Int
  explanation      String
}

model Outcome {
  id               String   @id @default(uuid())
  decisionId       String   @unique
  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  whatWasDecided   String
  whatHappened     String
  revenueResult    String?
  customerResult   String?
  experimentResult String?
  success          Boolean
  notes            String?
  predictionVsOutcome String?
  whatSystemGotRight String?
  whatSystemGotWrong String?
  failedAssumptions String?
  recurringBlindSpots String?
  lessonsLearned    String?
}
